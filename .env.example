# Set this to the canonical public storefront origin before deployment.
NEXT_PUBLIC_SITE_URL=

# Shopify integration is server-only. Configure all required values before enabling live commerce.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Optional: exact host returned by Shopify checkout if it differs from SHOPIFY_STORE_DOMAIN.
SHOPIFY_CHECKOUT_HOST=
